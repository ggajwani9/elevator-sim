POST http://localhost:8080/api/simulations
Content-Type: application/json

{
  "elevators": 2,
  "floors": 51,
  "capacity": 10,
  "requests": [
    {"time": 0, "id": "passenger1", "source": 1, "dest": 99}
  ]
}

